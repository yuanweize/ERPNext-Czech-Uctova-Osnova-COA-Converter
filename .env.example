# ─── ERPNext Czech COA Converter ───
# Copy to .env and fill your own keys.
# Mode: commercial (default) | public_sector
MODE=commercial

# LLM Provider: siliconflow | openrouter | openai | gemini
PROVIDER=siliconflow

# SiliconFlow
SILICONFLOW_API_KEY=YOUR_KEY_HERE
MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Translation
# Set to true to translate; false keeps Czech-only CSV
TRANSLATE_ENABLED=false
# Two-letter codes, max 2; examples: en,zh (default), kr, de,pl
TRANSLATE_LANGS=en,zh

# Runtime
MAX_WORKERS=16
BATCH_SIZE=8
CURRENCY=CZK
LIMIT=131
OUTPUT_PREFIX=erpnext_coa
